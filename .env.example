# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
#
# Ketiga variabel di bawah WAJIB. Aplikasi akan gagal dengan pesan yang
# menyebut nama variabel yang kurang kalau salah satu belum diisi.
#
# Semuanya berawalan NEXT_PUBLIC_ karena memang aman terkirim ke peramban:
# kunci anon Supabase dirancang untuk publik, dan Row Level Security yang
# menjaga datanya. JANGAN pernah menaruh service role key di berkas ini.
# ---------------------------------------------------------------------------

# URL proyek Supabase Anda.
# Dapatkan di: Supabase Dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://contoh-project-ref.supabase.co

# Kunci anon (publishable) proyek Supabase Anda — bukan service role key.
# Dapatkan di: Supabase Dashboard > Project Settings > API Keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.contoh.kunci-anon-anda

# URL dasar situs, tanpa garis miring di akhir.
# Dipakai untuk URL kanonik, tag Open Graph, dan sitemap.xml.
# Lokal: http://localhost:3000
# Produksi: https://domain-anda.com (atau URL yang diberikan Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
