# ---------------------------------------------------------------------------
# Salin berkas ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
#
# Ketiga variabel di bawah WAJIB. Aplikasi akan gagal dengan pesan yang
# menyebut nama variabel yang kurang kalau salah satu belum diisi.
#
# Semuanya berawalan NEXT_PUBLIC_ karena memang aman terkirim ke peramban:
# kunci anon Supabase dirancang untuk publik, dan Row Level Security yang
# menjaga datanya. JANGAN pernah menaruh service role key di berkas ini.
# ---------------------------------------------------------------------------

# URL proyek Supabase Anda.
# Dapatkan di: Supabase Dashboard > Project Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://contoh-project-ref.supabase.co

# Kunci anon (publishable) proyek Supabase Anda — bukan service role key.
# Dapatkan di: Supabase Dashboard > Project Settings > API Keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.contoh.kunci-anon-anda

# URL dasar situs, tanpa garis miring di akhir.
# Dipakai untuk URL kanonik, tag Open Graph, dan sitemap.xml.
# Lokal: http://localhost:3000
# Produksi: https://domain-anda.com (atau URL yang diberikan Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Dashboard admin. HANYA server — JANGAN diberi awalan NEXT_PUBLIC_.
#
# Kalau diberi awalan NEXT_PUBLIC_, nilainya ikut masuk ke bundel JavaScript
# yang dikirim ke peramban, sehingga allowlist admin terlihat oleh siapa pun
# yang membuka situs. Pemeriksaan email admin harus terjadi di server.
# ---------------------------------------------------------------------------

# Email satu-satunya akun admin yang boleh masuk ke /admin.
# Harus sama dengan email pengguna yang Anda buat di Supabase Authentication.
ADMIN_EMAIL=email.anda@contoh.com

# ---------------------------------------------------------------------------
# Form publik — HANYA server, JANGAN diberi awalan NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# WAJIB. Garam acak untuk hash pengenal pengirim pada pembatasan laju.
# Penghitung laju menyimpan hash, bukan alamat IP — garam inilah yang membuat
# hash itu tidak bisa dibalik dengan menebak seluruh ruang alamat.
# Hasilkan dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=ganti-dengan-nilai-acak-panjang

# WAJIB. Potongan alamat rahasia untuk halaman masuk admin.
# Alamat /admin sendiri dialihkan ke beranda bagi yang belum masuk, sehingga
# pemindai otomatis tidak menemukan form masuk di sana.
#
# Ini mengurangi kebisingan bot, BUKAN menambah keamanan — yang menjaga
# dashboard tetaplah pemeriksaan sesi. Pilih nilai yang tidak mudah ditebak.
# Huruf, angka, dan tanda hubung saja. Contoh: masuk-7f3a9c21
ADMIN_LOGIN_PATH=masuk-ganti-dengan-nilai-acak
